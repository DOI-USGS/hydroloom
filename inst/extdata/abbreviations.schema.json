{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hydroloom abbreviations",
  "description": "Map from an abbreviation to its expansion (SPEC S-1, S-2; filled by G-16).",
  "type": "object",
  "required": ["version", "abbreviations"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "abbreviations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
