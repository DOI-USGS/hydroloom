{
  "name": "hl-implementer",
  "description": "Implements one hydroloom Python function from its algorithm description and the SPEC anchors it cites, never reading R/. Use for the implement step of port-function.",
  "prompt": "file://hl-implementer.prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "R/**",
          "tests/testthat/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/hydroloom/**",
          "tests/python/**",
          "changelog.d/**",
          ".kiro/workflow-output/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "src/hydroloom/**",
          "tests/python/**",
          "changelog.d/**",
          ".kiro/workflow-output/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pixi run lint*",
          "pixi run test*",
          "pixi run install*",
          "pixi reinstall hydroloom",
          "git status",
          "git status --short",
          "git status -s",
          "git status --porcelain",
          "git status -- *",
          "git status --short -- *",
          "git status -s -- *",
          "git status --porcelain -- *",
          "git diff -- src/hydroloom/*",
          "git diff -- tests/python/*",
          "git diff -- changelog.d/*",
          "git diff --stat -- src/hydroloom/*",
          "git diff --stat -- tests/python/*",
          "git diff --stat -- changelog.d/*",
          "git add src/hydroloom/*",
          "git add tests/python/*",
          "git add changelog.d/*",
          "git commit -m * --trailer \"Assisted-by: Kiro (claude-opus-5.5)\"",
          "git commit -m * --trailer Assisted-by: Kiro (claude-opus-5.5)"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pixi run lint*",
          "pixi run test*",
          "pixi run install*",
          "pixi reinstall hydroloom",
          "git status",
          "git status --short",
          "git status -s",
          "git status --porcelain",
          "git status -- *",
          "git status --short -- *",
          "git status -s -- *",
          "git status --porcelain -- *",
          "git diff -- src/hydroloom/*",
          "git diff -- tests/python/*",
          "git diff -- changelog.d/*",
          "git diff --stat -- src/hydroloom/*",
          "git diff --stat -- tests/python/*",
          "git diff --stat -- changelog.d/*",
          "git add src/hydroloom/*",
          "git add tests/python/*",
          "git add changelog.d/*",
          "git commit -m * --trailer \"Assisted-by: Kiro (claude-opus-5.5)\"",
          "git commit -m * --trailer Assisted-by: Kiro (claude-opus-5.5)"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pixi *"
        ],
        "exclude": [
          "pixi run lint*",
          "pixi run test*",
          "pixi run install*",
          "pixi reinstall hydroloom"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git diff*"
        ],
        "exclude": [
          "git diff -- src/hydroloom/*",
          "git diff -- tests/python/*",
          "git diff -- changelog.d/*",
          "git diff --stat -- src/hydroloom/*",
          "git diff --stat -- tests/python/*",
          "git diff --stat -- changelog.d/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git show*",
          "git log*",
          "git cat-file*",
          "git grep*",
          "git blame*",
          "git checkout*",
          "git restore*",
          "git switch*",
          "git stash*",
          "git ls-files*",
          "git ls-tree*",
          "git archive*",
          "git apply*",
          "git config*",
          "git -*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*$*",
          "*`*",
          "*>*",
          "*@(*",
          "git status*(*",
          "git diff*(*",
          "git add*(*",
          "git diff* -- * *",
          "git diff* -- *\t*",
          "git diff*..*",
          "git add*..*",
          "git add * *",
          "git add*\t*",
          "git add* -*",
          "git add*R/*",
          "git add*testthat*",
          "git add*inst/*",
          "git commit -m*(*--trailer*",
          "git commit*--trailer*(*(*",
          "git commit -m * -* --trailer *"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git reset --hard*",
          "rm -rf *"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/kernels.md",
    "file://.kiro/steering/harness.md",
    "file://.kiro/context/pattern-files.md",
    "file://.kiro/context/pr-body-template.md",
    "file://.kiro/context/prose.md"
  ]
}
